{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./demo/*"]
    }
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "demo/**/*.vue", "adapters/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "server", "pipeline"]
}
